<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Rounded A: left leg, apex and right leg as one stroke so the joint
         stays flush instead of overlapping round caps. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M32,80 L54,29 L76,80"
        android:strokeColor="#4D9EFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="8" />
    <!-- Rounded A: crossbar ends on the leg centrelines, tucked under them. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M41,59 L66,59"
        android:strokeColor="#3A7FD5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="8" />
</vector>
